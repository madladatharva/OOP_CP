<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<c:set var="uri" value="${pageContext.request.requestURI}" />
<c:set var="displayName" value="${not empty sessionScope.fullName ? sessionScope.fullName : sessionScope.username}" />
<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-logo">A</div>
        <div class="brand-text">
            <div class="brand-name">AdaptIQ</div>
            <div class="brand-subtitle">Teacher workspace</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-title">Teaching</div>
        <a href="${pageContext.request.contextPath}/teacher/dashboard" class="${fn:contains(uri, '/teacher/dashboard') ? 'active' : ''}">
            <span class="material-icons-outlined">space_dashboard</span>
            <span>Overview</span>
        </a>
        <a href="${pageContext.request.contextPath}/teacher/classes" class="${fn:contains(uri, '/teacher/classes') ? 'active' : ''}">
            <span class="material-icons-outlined">groups</span>
            <span>Classes</span>
        </a>
        <a href="${pageContext.request.contextPath}/teacher/questions" class="${fn:contains(uri, '/teacher/questions') ? 'active' : ''}">
            <span class="material-icons-outlined">quiz</span>
            <span>Question Bank</span>
        </a>
        <a href="${pageContext.request.contextPath}/teacher/quizzes" class="${fn:contains(uri, '/teacher/quizzes') ? 'active' : ''}">
            <span class="material-icons-outlined">assignment</span>
            <span>Quizzes</span>
        </a>
        <a href="${pageContext.request.contextPath}/teacher/analytics" class="${fn:contains(uri, '/teacher/analytics') ? 'active' : ''}">
            <span class="material-icons-outlined">monitoring</span>
            <span>Analytics</span>
        </a>

        <div class="nav-section-title">Account</div>
        <a href="${pageContext.request.contextPath}/logout">
            <span class="material-icons-outlined">logout</span>
            <span>Sign Out</span>
        </a>
    </nav>

    <div class="sidebar-user">
        <div class="user-avatar">
            ${fn:substring(displayName, 0, 1)}
        </div>
        <div class="user-info">
            <div class="user-name">${displayName}</div>
            <div class="user-role">Teacher</div>
        </div>
    </div>
</aside>
